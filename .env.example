# scrapeit configuration — copy to `.env` and fill in.
#
# This file is customization surface #1: the LLMs, and the exit path.
# The other two are sources.yaml and data_model.yaml.

# ---------------------------------------------------------------------------
# LLM #1 — SCRAPE
# Drives the browser: explores the page and finds the content items.
# Needs reliable tool-calling.
# ---------------------------------------------------------------------------
LLM_SCRAPE_BASE_URL=
LLM_SCRAPE_API_KEY=
LLM_SCRAPE_MODEL=

# ---------------------------------------------------------------------------
# LLM #2 — EXTRACT
# Reads the raw items and fills the fields from data_model.yaml.
# Any field left blank here falls back to the SCRAPE value, so a single-provider
# setup only needs the three lines above.
# ---------------------------------------------------------------------------
LLM_EXTRACT_BASE_URL=
LLM_EXTRACT_API_KEY=
LLM_EXTRACT_MODEL=

# ---------------------------------------------------------------------------
# Exit path — where extracted rows are POSTed.
# Leave SINK_ENDPOINT_URL empty to skip the POST entirely; rows are still
# written to _staging/.
# ---------------------------------------------------------------------------
SINK_ENDPOINT_URL=
# Header the token goes in, and the scheme prefixed to it.
#   Authorization + Bearer  ->  Authorization: Bearer <token>
# Use X-API-Key with an empty scheme for  ->  X-API-Key: <token>
SINK_AUTH_HEADER=Authorization
SINK_AUTH_SCHEME=Bearer
SINK_AUTH_TOKEN=

# batch = one request per source (default).  item = one request per row.
SINK_MODE=batch
SINK_MAX_RETRIES=3
SINK_TIMEOUT=30
